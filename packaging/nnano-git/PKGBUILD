# Maintainer: Nestor Pons <nestorpons@gmail.com>
#
# Tracks main. A stable `nnano` package (release tarball, checksummed) follows
# the first tagged release; see ../README.md for the two-line change.
pkgname=nnano-git
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern, nano-compatible terminal text editor (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/nestorPons/neo-nano"
license=('MIT')
depends=('gcc-libs')
makedepends=('git' 'cargo')
provides=('nnano')
conflicts=('nnano')
source=("$pkgname::git+https://github.com/nestorPons/neo-nano.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo"
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo"
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/nnano "$pkgdir/usr/bin/nnano"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/nnano/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/nnano/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/nnano/CHANGELOG.md"
  for lang in en es zh-Hans ja hi ar fr bn pt id; do
    install -Dm644 "docs/$lang/shortcuts.md" \
      "$pkgdir/usr/share/doc/nnano/shortcuts.$lang.md"
  done
}
